{
  "name": "@codearena/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for building CodeArena bots",
  "license": "MIT",
  "author": "CodeArena Platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codearena-platform/codearena-sdk.git",
    "directory": "typescript"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "proto",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --outDir=src/generated --includeDirs=proto --keepCase=false --longs=Number --enums=Number --defaults=false --oneofs=true v1/bot_api.proto",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest --runInBand",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "jest": "29.7.0",
    "protobufjs": "7.6.6",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codearena",
    "grpc",
    "bot"
  ]
}
